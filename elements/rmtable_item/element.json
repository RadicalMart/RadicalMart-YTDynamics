{
  "@import": "./element.php",
  "name": "rmtable_item",
  "title": "RM Table Row",
  "width": 500,
  "placeholder": {
    "children": [
      {"type": "rmtable_cell", "props": {"text": "Column 1"}},
      {"type": "rmtable_cell", "props": {"text": "Column 2"}},
      {"type": "rmtable_cell", "props": {"text": "Column 3"}}
    ]
  },
  "defaults": {
    "row_type": "body",
    "row_background": "",
    "row_active": false
  },
  "templates": {
    "render": "./templates/template.php",
    "content": "./templates/content.php"
  },
  "fields": {
    "content": {"label": "Cells", "type": "content-items", "item": "rmtable_cell"},
    "row_type": {
      "label": "Section",
      "description": "Header and footer rows are grouped into the semantic table sections automatically.",
      "type": "select",
      "options": {"Header": "head", "Body": "body", "Footer": "foot"}
    },
    "row_background": {
      "label": "Background",
      "type": "select",
      "options": {"None": "", "Muted": "muted", "Primary": "primary", "Secondary": "secondary"}
    },
    "row_active": {"type": "checkbox", "text": "Active row state"},
    "name": "${builder.nameItem}",
    "status": "${builder.statusItem}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS for this table row and its cells.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {"debounce": 500, "hints": [".el-item", ".rm-table__cell", ".rm-table__cell-content"]}
    }
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {"title": "Content", "fields": ["content", "row_type"]},
        {"title": "Settings", "fields": [{"label": "Row", "type": "group", "fields": ["row_background", "row_active"]}]},
        "${builder.advancedItem}"
      ]
    }
  }
}
