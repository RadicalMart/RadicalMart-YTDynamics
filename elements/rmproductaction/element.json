{
  "@import": "./element.php", "name": "rmproductaction", "title": "RM Product Action", "group": "RadicalMart — Product Actions", "icon": "${url:images/iconPicker.svg}", "iconSmall": "${url:images/iconSmall.svg}", "element": true, "width": 500,
  "defaults": {"action": "favorite", "favorite_label": "", "compare_label": "", "favorite_icon": "heart", "compare_icon": "copy", "button_style": "default", "button_size": "", "fullwidth": false, "icon_only": true}, "templates": {"render": "./templates/template.php"},
  "fields": {"product_id": {"label": "Product ID", "type": "number", "source": true}, "action": {"label": "Action", "type": "select", "options": {"Favorite": "favorite", "Compare": "compare"}}, "favorite_label": {"label": "Favorite label", "type": "text", "source": true, "show": "action == 'favorite'"}, "compare_label": {"label": "Compare label", "type": "text", "source": true, "show": "action == 'compare'"}, "favorite_icon": {"label": "Favorite icon", "type": "icon", "show": "action == 'favorite'"}, "compare_icon": {"label": "Compare icon", "type": "icon", "show": "action == 'compare'"}, "button_style": {"label": "Button style", "type": "select", "options": {"Default": "default", "Primary": "primary", "Secondary": "secondary", "Text": "text", "Link": "link"}, "show": "!icon_only"}, "button_size": {"label": "Button size", "type": "select", "options": {"Default": "", "Small": "small", "Large": "large"}, "show": "!icon_only"}, "fullwidth": {"type": "checkbox", "text": "Full width", "show": "!icon_only"}, "icon_only": {"type": "checkbox", "text": "Icon-only button"},
  "margin_top": "${builder.margin_top}", "margin_bottom": "${builder.margin_bottom}", "visibility": "${builder.visibility}", "name": "${builder.name}", "status": "${builder.status}", "source": "${builder.source}", "id": "${builder.id}", "class": "${builder.cls}", "attributes": "${builder.attrs}", "css": {"label": "CSS", "type": "editor", "editor": "code", "mode": "css", "attrs": {"hints": [".el-element", ".rm-product-action", ".rm-product-action--favorite", ".rm-product-action--compare"]}}, "transform": "${builder.transform}"},
  "fieldset": {"default": {"type": "tabs", "fields": [{"title": "Settings", "fields": [{"label": "Action", "type": "group", "fields": ["product_id", "action", "favorite_label", "compare_label", "favorite_icon", "compare_icon", "icon_only", "button_style", "button_size", "fullwidth"]}, {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "visibility"]}]}, "${builder.advanced}"]}}
}
