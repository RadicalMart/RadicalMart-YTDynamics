{
  "@import": "./element.php",
  "name": "rmbuy",
  "title": "RM Add to Cart",
  "group": "RadicalMart",
  "icon": "${url:images/icon.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "width": 500,
  "defaults": {
    "step": 1,
    "min": 1,
    "max": "",
    "show_count": true,
    "label": "",
    "icon": "",
    "icon_align": "left",
    "button_style": "primary",
    "button_size": "",
    "mobile_stack": true,
    "fullwidth": false
  },
  "templates": {
    "render": "./templates/template.php",
    "content": "./templates/content.php"
  },
  "fields": {
    "product_id": {
      "label": "Product ID",
      "type": "number",
      "source": true
    },
    "step": {
      "label": "Step",
      "type": "number",
      "source": true
    },
    "min": {
      "label": "Min",
      "type": "number",
      "source": true
    },
    "max": {
      "label": "Max",
      "type": "number",
      "source": true
    },
    "show_count": {
      "label": "Show count",
      "type": "checkbox"
    },
    "label": {
      "label": "Button label",
      "description": "Leave empty to use the RadicalMart add-to-cart translation.",
      "type": "text",
      "source": true
    },
    "icon": {"label": "Button icon", "type": "icon"},
    "icon_align": {
      "label": "Icon position",
      "type": "select",
      "options": {"Before label": "left", "After label": "right"},
      "show": "icon"
    },
    "button_style": {
      "label": "Button style",
      "type": "select",
      "options": {"Default": "default", "Primary": "primary", "Secondary": "secondary", "Danger": "danger", "Text": "text", "Link": "link"}
    },
    "button_size": {
      "label": "Button size",
      "type": "select",
      "options": {"Default": "", "Small": "small", "Large": "large"}
    },
    "mobile_stack": {
      "type": "checkbox",
      "text": "Stack quantity and button on phones",
      "description": "Prevents overflow in narrow cards, modal windows and offcanvas panels. Desktop layout remains inline."
    },
    "fullwidth": {"type": "checkbox", "text": "Full width button"},
    "position": "${builder.position}",
    "position_left": "${builder.position_left}",
    "position_right": "${builder.position_right}",
    "position_top": "${builder.position_top}",
    "position_bottom": "${builder.position_bottom}",
    "position_z_index": "${builder.position_z_index}",
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "maxwidth": "${builder.maxwidth}",
    "maxwidth_breakpoint": "${builder.maxwidth_breakpoint}",
    "block_align": "${builder.block_align}",
    "block_align_breakpoint": "${builder.block_align_breakpoint}",
    "block_align_fallback": "${builder.block_align_fallback}",
    "text_align": "${builder.text_align}",
    "text_align_breakpoint": "${builder.text_align_breakpoint}",
    "text_align_fallback": "${builder.text_align_fallback}",
    "animation": "${builder.animation}",
    "_parallax_button": "${builder._parallax_button}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS is scoped to this element. Use the root and RadicalMart component selectors listed below.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {
        "debounce": 500,
        "hints": [
          ".el-element",
          ".rm-buy",
          ".rm-buy__quantity",
          ".rm-buy__decrease",
          ".rm-buy__input",
          ".rm-buy__increase",
          ".rm-buy__action",
          ".rm-buy__button"
        ]
      }
    },
    "transform": "${builder.transform}"
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {
          "title": "Settings",
          "fields": [
            {
              "label": "Button",
              "type": "group",
              "fields": [
                "show_count",
                "product_id",
                "step",
                "min",
                "max",
                "label",
                "icon",
                "icon_align",
                "button_style",
                "button_size",
                "mobile_stack",
                "fullwidth"
              ]
            },
            {
              "label": "General",
              "type": "group",
              "fields": [
                "position",
                "position_left",
                "position_right",
                "position_top",
                "position_bottom",
                "position_z_index",
                "margin_top",
                "margin_bottom",
                "maxwidth",
                "maxwidth_breakpoint",
                "block_align",
                "block_align_breakpoint",
                "block_align_fallback",
                "text_align",
                "text_align_breakpoint",
                "text_align_fallback",
                "animation",
                "_parallax_button",
                "visibility"
              ]
            }
          ]
        },
        "${builder.advanced}"
      ]
    }
  }
}
