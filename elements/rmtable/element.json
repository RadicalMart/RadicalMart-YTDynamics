{
  "@import": "./element.php",
  "name": "rmtable",
  "title": "RM Table",
  "group": "RadicalMart",
  "icon": "${url:images/icon.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "container": true,
  "width": 500,
  "placeholder": {
    "children": [
      {"type": "rmtable_item", "props": {"row_type": "head", "name": "Header row"}},
      {"type": "rmtable_item", "props": {"row_type": "body", "name": "Body row"}},
      {"type": "rmtable_item", "props": {"row_type": "body", "name": "Body row"}}
    ]
  },
  "defaults": {
    "mode": "default",
    "table_style": "divider",
    "table_size": "",
    "table_hover": true,
    "table_justify": false,
    "table_vertical_align": true,
    "responsive_mode": "scroll",
    "responsive_breakpoint": "m",
    "sticky_header": false,
    "sticky_first": false,
    "sticky_last": false,
    "caption_position": "top",
    "empty_text": "No rows"
  },
  "templates": {
    "render": "./templates/template.php",
    "content": "./templates/content.php"
  },
  "fields": {
    "content": {"label": "Rows", "type": "content-items", "item": "rmtable_item"},
    "mode": {
      "label": "Display mode",
      "type": "select",
      "options": {"Always": "default", "RadicalMart table layout": "radicalmart_table"}
    },
    "caption": {
      "label": "Caption",
      "description": "Accessible title displayed with the table.",
      "type": "text",
      "source": true
    },
    "caption_position": {
      "label": "Caption position",
      "type": "select",
      "options": {"Top": "top", "Bottom": "bottom"},
      "enable": "caption"
    },
    "empty_text": {"label": "Empty state", "type": "text", "source": true},
    "table_style": {
      "label": "Style",
      "type": "select",
      "options": {"Default": "", "Divider": "divider", "Striped": "striped"}
    },
    "table_size": {
      "label": "Cell padding",
      "type": "select",
      "options": {"Default": "", "Small": "small", "Large": "large"}
    },
    "table_hover": {"type": "checkbox", "text": "Highlight row on hover"},
    "table_justify": {"type": "checkbox", "text": "Remove outer horizontal padding"},
    "table_vertical_align": {"type": "checkbox", "text": "Vertically center cells"},
    "responsive_mode": {
      "label": "Responsive mode",
      "type": "select",
      "options": {"Horizontal scroll": "scroll", "Stacked rows": "stack", "Cards": "cards", "None": "none"}
    },
    "responsive_breakpoint": {
      "label": "Responsive breakpoint",
      "type": "select",
      "options": {"Small — 640px": "s", "Medium — 960px": "m", "Large — 1200px": "l", "X-Large — 1600px": "xl"},
      "show": "responsive_mode == 'stack' || responsive_mode == 'cards'"
    },
    "sticky_header": {"type": "checkbox", "text": "Sticky header"},
    "sticky_first": {"type": "checkbox", "text": "Sticky first column"},
    "sticky_last": {"type": "checkbox", "text": "Sticky last column"},
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "maxwidth": "${builder.maxwidth}",
    "maxwidth_breakpoint": "${builder.maxwidth_breakpoint}",
    "block_align": "${builder.block_align}",
    "block_align_breakpoint": "${builder.block_align_breakpoint}",
    "block_align_fallback": "${builder.block_align_fallback}",
    "animation": "${builder.animation}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS is scoped to this table. Use the selectors below for semantic sections, rows, cells and cell content.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {"debounce": 500, "hints": [".el-element", ".rm-table", ".rm-table__caption", ".rm-table__head", ".rm-table__body", ".rm-table__foot", ".rm-table__row", ".rm-table__cell", ".rm-table__cell-content", ".rm-table__empty", ".rm-table__empty-cell"]}
    },
    "transform": "${builder.transform}"
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {"title": "Content", "fields": ["content", "mode", "caption", "caption_position", "empty_text"]},
        {
          "title": "Settings",
          "fields": [
            {"label": "Table", "type": "group", "fields": ["table_style", "table_size", "table_hover", "table_justify", "table_vertical_align"]},
            {"label": "Responsive", "type": "group", "divider": true, "fields": ["responsive_mode", "responsive_breakpoint"]},
            {"label": "Sticky", "type": "group", "divider": true, "fields": ["sticky_header", "sticky_first", "sticky_last"]},
            {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "maxwidth", "maxwidth_breakpoint", "block_align", "block_align_breakpoint", "block_align_fallback", "animation", "visibility"]}
          ]
        },
        "${builder.advanced}"
      ]
    }
  }
}
