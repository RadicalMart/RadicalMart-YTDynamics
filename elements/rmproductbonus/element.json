{
  "@import": "./element.php", "name": "rmproductbonus", "title": "RM Product Bonus", "group": "RadicalMart — Product Data", "icon": "${url:images/iconPicker.svg}", "iconSmall": "${url:images/iconSmall.svg}", "element": true, "width": 500,
