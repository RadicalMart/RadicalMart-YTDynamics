{
    "@import": "./element.php",
    "name": "rmslideshow_item",
    "title": "Item",
    "width": 500,
    "templates": {
        "render": "./templates/template.php",
        "content": "./templates/content.php"
    },
    "fields": {
        "image": "${builder.image}",
        "image_alt": {
            "label": "Image Alt",
            "source": true,
            "enable": "image"
        },
        "image_fit": {
            "label": "Image Fit",
            "description": "Override the slideshow image fit for this slide.",
            "type": "select",
            "options": {"Inherit": "", "Contain": "contain", "Cover": "cover"},
            "source": true
        },
        "image_position": {
            "label": "Image Position",
            "description": "Override the slideshow image position for this slide.",
            "type": "select",
            "options": {"Inherit": "", "Center": "center", "Top Left": "top-left", "Top Center": "top-center", "Top Right": "top-right", "Center Left": "center-left", "Center Right": "center-right", "Bottom Left": "bottom-left", "Bottom Center": "bottom-center", "Bottom Right": "bottom-right"},
            "source": true
        },
        "background_color": {
            "label": "Background Color",
            "description": "Override the slideshow background for this slide and its thumbnail.",
            "type": "color",
            "source": true
        },
        "mix_blend_mode": {
            "label": "Image Blend Mode",
            "description": "Override the slideshow blend mode for this slide.",
            "type": "select",
            "options": {"Inherit": "", "Normal": "normal", "Multiply": "multiply", "Screen": "screen", "Overlay": "overlay", "Darken": "darken", "Lighten": "lighten", "Color Dodge": "color-dodge", "Color Burn": "color-burn", "Hard Light": "hard-light", "Soft Light": "soft-light", "Difference": "difference", "Exclusion": "exclusion", "Hue": "hue", "Saturation": "saturation", "Color": "color", "Luminosity": "luminosity"},
            "source": true
        },
        "name": "${builder.nameItem}",
        "status": "${builder.statusItem}",
        "source": "${builder.source}",
        "id": "${builder.id}",
        "class": "${builder.cls}",
        "attributes": "${builder.attrs}",
        "css": {
            "label": "CSS",
            "description": "Custom CSS for this main slide. Thumbnail styling belongs to the parent RM Slideshow element.",
            "type": "editor",
            "editor": "code",
            "mode": "css",
            "attrs": {"debounce": 500, "hints": [".el-item", ".rmslideshow__slide__image", ".rmslideshow__lightbox", ".rmslideshow__lightbox-icon"]}
        }
    },
    "fieldset": {
        "default": {
            "type": "tabs",
            "fields": [
                {
                    "title": "Content",
                    "fields": [
                        "image",
                        "image_alt"
                    ]
                },
                {
                    "title": "Settings",
                    "fields": [
                        {"label": "Media", "type": "group", "fields": ["image_fit", "image_position", "background_color", "mix_blend_mode"]}
                    ]
                },
                "${builder.advancedItem}"
            ]
        }
    }
}
