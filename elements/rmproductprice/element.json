{
  "@import": "./element.php",
  "name": "rmproductprice",
  "title": "RM Product Price",
  "group": "RadicalMart — Product Data",
  "icon": "${url:images/iconPicker.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "width": 500,
  "defaults": {
    "show_unit": true,
    "unit_style": "short",
    "unit_separator": "/",
    "show_base_price": true,
    "show_discount": true,
    "discount_mode": "percent",
    "discount_style": "danger",
    "show_savings": false,
    "savings_prefix": "Экономия ",
    "layout": "inline",
    "gap": "small",
    "final_style": "large",
    "final_weight": "bold",
    "final_color": "emphasis",
    "unit_style_text": "",
    "unit_color": "",
    "base_style": "",
    "base_color": "muted",
    "before_value": "",
    "after_value": ""
  },
  "templates": {"render": "./templates/template.php"},
  "fields": {
    "product_id": {
      "label": "Product ID",
      "description": "Optional outside RM Product or RM Product Card. Inside a product context the parent product is used automatically.",
      "type": "number",
      "source": true
    },
    "show_unit": {"type": "checkbox", "text": "Append the product unit to the final price"},
    "unit_style": {
      "label": "Unit label",
      "type": "select",
      "options": {"Short": "short", "Long": "long"},
      "show": "show_unit"
    },
    "unit_separator": {
      "label": "Price / unit separator",
      "description": "For example /, · or a single space.",
      "type": "text",
      "show": "show_unit"
    },
    "show_base_price": {"type": "checkbox", "text": "Show the crossed-out base price when discounted"},
    "show_discount": {"type": "checkbox", "text": "Show a discount badge when discounted"},
    "discount_mode": {
      "label": "Discount value",
      "type": "select",
      "options": {"Percentage": "percent", "Amount": "amount", "Percentage and amount": "both"},
      "show": "show_discount"
    },
    "discount_style": {
      "label": "Discount badge style",
      "type": "select",
      "options": {"Default": "", "Success": "success", "Warning": "warning", "Danger": "danger"},
      "show": "show_discount"
    },
    "show_savings": {"type": "checkbox", "text": "Show savings as a separate value"},
    "savings_prefix": {
      "label": "Savings prefix",
      "type": "text",
      "source": true,
      "show": "show_savings"
    },
    "layout": {
      "label": "Layout",
      "type": "select",
      "options": {"Inline": "inline", "Inline and wrap": "wrap", "Stacked": "stack"}
    },
    "gap": {
      "label": "Items gap",
      "type": "select",
      "options": {"None": "none", "Small": "small", "Default": "default", "Large": "large"}
    },
    "final_style": {
      "label": "Final price style",
      "type": "select",
      "options": {"Default": "", "Meta": "meta", "Small": "small", "Large": "large", "Lead": "lead"}
    },
    "final_weight": {
      "label": "Final price weight",
      "type": "select",
      "options": {"Inherit": "", "Light": "light", "Normal": "normal", "Bold": "bold", "Lighter": "lighter", "Bolder": "bolder"}
    },
    "final_color": {
      "label": "Final price color",
      "type": "select",
      "options": {"Inherit": "", "Muted": "muted", "Emphasis": "emphasis", "Primary": "primary", "Secondary": "secondary", "Success": "success", "Warning": "warning", "Danger": "danger"}
    },
    "unit_style_text": {
      "label": "Unit text style",
      "type": "select",
      "options": {"Inherit": "", "Meta": "meta", "Small": "small", "Large": "large", "Lead": "lead"},
      "show": "show_unit"
    },
    "unit_color": {
      "label": "Unit color",
      "type": "select",
      "options": {"Inherit": "", "Muted": "muted", "Emphasis": "emphasis", "Primary": "primary", "Secondary": "secondary", "Success": "success", "Warning": "warning", "Danger": "danger"},
      "show": "show_unit"
    },
    "base_style": {
      "label": "Base price style",
      "type": "select",
      "options": {"Default": "", "Meta": "meta", "Small": "small", "Large": "large", "Lead": "lead"},
      "show": "show_base_price"
    },
    "base_color": {
      "label": "Base price color",
      "type": "select",
      "options": {"Inherit": "", "Muted": "muted", "Emphasis": "emphasis", "Primary": "primary", "Secondary": "secondary", "Success": "success", "Warning": "warning", "Danger": "danger"},
      "show": "show_base_price"
    },
    "before_value": {
      "label": "Before price",
      "description": "Optional content before the complete price. Dynamic content is supported.",
      "type": "text",
      "source": true
    },
    "after_value": {
      "label": "After price",
      "description": "Optional content after the complete price. Dynamic content is supported.",
      "type": "text",
      "source": true
    },
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "maxwidth": "${builder.maxwidth}",
    "maxwidth_breakpoint": "${builder.maxwidth_breakpoint}",
    "block_align": "${builder.block_align}",
    "block_align_breakpoint": "${builder.block_align_breakpoint}",
    "block_align_fallback": "${builder.block_align_fallback}",
    "text_align": "${builder.text_align}",
    "text_align_breakpoint": "${builder.text_align_breakpoint}",
    "text_align_fallback": "${builder.text_align_fallback}",
    "animation": "${builder.animation}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS is scoped to this price element.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {"debounce": 500, "hints": [".el-element", ".rm-product-price", ".rm-product-price__final-group", ".rm-product-price__final", ".rm-product-price__unit", ".rm-product-price__base", ".rm-product-price__discount", ".rm-product-price__savings"]}
    },
    "transform": "${builder.transform}"
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {"title": "Settings", "fields": [
          {"label": "Price", "type": "group", "fields": ["product_id", "show_unit", "unit_style", "unit_separator", "show_base_price", "show_discount", "discount_mode", "discount_style", "show_savings", "savings_prefix", "before_value", "after_value"]},
          {"label": "Layout", "type": "group", "fields": ["layout", "gap", "final_style", "final_weight", "final_color", "unit_style_text", "unit_color", "base_style", "base_color"]},
          {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "maxwidth", "maxwidth_breakpoint", "block_align", "block_align_breakpoint", "block_align_fallback", "text_align", "text_align_breakpoint", "text_align_fallback", "animation", "visibility"]}
        ]},
        "${builder.advanced}"
      ]
    }
  }
}
