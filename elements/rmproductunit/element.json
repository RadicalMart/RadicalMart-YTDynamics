{
  "@import": "./element.php", "name": "rmproductunit", "title": "RM Product Unit Price", "group": "RadicalMart — Product Data", "icon": "${url:images/iconPicker.svg}", "iconSmall": "${url:images/iconSmall.svg}", "element": true, "width": 500,
  "defaults": {"show_price": true, "unit_style": "short", "separator": "/", "text_style": "meta"}, "templates": {"render": "./templates/template.php"},
  "fields": {"product_id": {"label": "Product ID", "type": "number", "source": true}, "show_price": {"type": "checkbox", "text": "Show current price before the unit"}, "unit_style": {"label": "Unit label", "type": "select", "options": {"Short": "short", "Long": "long"}}, "separator": {"label": "Separator", "type": "text", "show": "show_price"}, "text_style": {"label": "Text style", "type": "select", "options": {"Default": "", "Meta": "meta", "Small": "small", "Lead": "lead"}},
  "margin_top": "${builder.margin_top}", "margin_bottom": "${builder.margin_bottom}", "visibility": "${builder.visibility}", "name": "${builder.name}", "status": "${builder.status}", "source": "${builder.source}", "id": "${builder.id}", "class": "${builder.cls}", "attributes": "${builder.attrs}", "css": {"label": "CSS", "type": "editor", "editor": "code", "mode": "css", "attrs": {"hints": [".el-element", ".rm-product-unit", ".rm-product-unit__price", ".rm-product-unit__separator", ".rm-product-unit__label"]}}, "transform": "${builder.transform}"},
  "fieldset": {"default": {"type": "tabs", "fields": [{"title": "Settings", "fields": [{"label": "Unit", "type": "group", "fields": ["product_id", "show_price", "unit_style", "separator", "text_style"]}, {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "visibility"]}]}, "${builder.advanced}"]}}
}
