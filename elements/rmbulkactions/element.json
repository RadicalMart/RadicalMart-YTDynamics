{
  "@import": "./element.php", "name": "rmbulkactions", "title": "RM Bulk Actions", "group": "RadicalMart — Catalog", "icon": "${url:images/iconPicker.svg}", "iconSmall": "${url:images/iconSmall.svg}", "element": true, "width": 500,
  "defaults": {"cart_label": "", "clear_label": "", "count_label": "", "button_style": "primary", "button_size": "", "show_clear": true, "selection_root": ""}, "templates": {"render": "./templates/template.php"},
  "fields": {"cart_label": {"label": "Cart button label", "description": "Leave empty for the RadicalMart translation.", "type": "text", "source": true}, "clear_label": {"label": "Clear button label", "type": "text", "source": true}, "count_label": {"label": "Count label", "type": "text", "source": true}, "button_style": {"label": "Button style", "type": "select", "options": {"Default": "default", "Primary": "primary", "Secondary": "secondary"}}, "button_size": {"label": "Button size", "type": "select", "options": {"Default": "", "Small": "small", "Large": "large"}}, "show_clear": {"type": "checkbox", "text": "Show clear selection action"}, "selection_root": {"label": "Selection root selector", "description": "Optional nearest ancestor or document selector. Leave empty to use the nearest RM Grid or section.", "type": "text"},
  "margin_top": "${builder.margin_top}", "margin_bottom": "${builder.margin_bottom}", "visibility": "${builder.visibility}", "name": "${builder.name}", "status": "${builder.status}", "source": "${builder.source}", "id": "${builder.id}", "class": "${builder.cls}", "attributes": "${builder.attrs}", "css": {"label": "CSS", "type": "editor", "editor": "code", "mode": "css", "attrs": {"hints": [".el-element", ".rm-bulk-actions", ".rm-bulk-actions__count", ".rm-bulk-actions__cart", ".rm-bulk-actions__clear"]}}, "transform": "${builder.transform}"},
  "fieldset": {"default": {"type": "tabs", "fields": [{"title": "Settings", "fields": [{"label": "Bulk actions", "type": "group", "fields": ["cart_label", "clear_label", "count_label", "button_style", "button_size", "show_clear", "selection_root"]}, {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "visibility"]}]}, "${builder.advanced}"]}}
}
