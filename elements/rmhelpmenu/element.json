{
  "@import": "./element.php",
  "name": "rmhelpmenu",
  "title": "RM Help Menu",
  "group": "RadicalMart — Navigation",
  "icon": "${url:images/iconPicker.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "container": true,
  "width": 500,
  "placeholder": {
    "children": [
      {"type": "rmhelpmenu_item", "props": {"title": "Позвонить", "icon": "receiver", "link": "tel:+79990000000", "background_color": "#315efb", "icon_color": "#ffffff"}},
      {"type": "rmhelpmenu_item", "props": {"title": "Написать в Telegram", "icon": "comments", "link": "https://t.me/example", "link_target": true, "background_color": "#2aabee", "icon_color": "#ffffff"}},
      {"type": "rmhelpmenu_item", "props": {"title": "Написать в WhatsApp", "icon": "commenting", "link": "https://wa.me/79990000000", "link_target": true, "background_color": "#25d366", "icon_color": "#ffffff"}},
      {"type": "rmhelpmenu_item", "props": {"title": "Написать на почту", "icon": "mail", "link": "mailto:mail@example.com", "background_color": "#1e87f0", "icon_color": "#ffffff"}},
      {"type": "rmhelpmenu_item", "props": {"title": "Раздел помощи", "icon": "question", "link": "/help", "background_color": "#6f42c1", "icon_color": "#ffffff"}}
    ]
  },
  "defaults": {
    "button_label": "Помощь и контакты",
    "button_icon": "receiver",
    "close_icon": "close",
    "button_pulse": true,
    "pulse_color": "",
    "pulse_opacity": 24,
    "pulse_scale": 145,
    "pulse_duration": 1800,
    "side": "right",
    "vertical_position": "bottom",
    "direction": "up",
    "visibility_mode": "all",
    "show_labels": false,
    "show_tooltips": true,
    "tooltip_delay": 120,
    "show_backdrop": true,
    "backdrop_color": "",
    "backdrop_opacity": 35,
    "close_on_link": true,
    "open_initially": false,
    "horizontal_offset": 20,
    "bottom_offset": 90,
    "z_index": 1040,
    "button_size": 68,
    "item_size": 56,
    "items_gap": 12,
    "button_background": "",
    "button_color": "",
    "item_background": "",
    "item_color": ""
  },
  "templates": {"render": "./templates/template.php", "content": "./templates/content.php"},
  "fields": {
    "content": {"label": "Contact links", "description": "Add static phone, email, messenger or help-page links. No chat integration is required.", "type": "content-items", "item": "rmhelpmenu_item"},
    "button_label": {"label": "Accessible button label", "type": "text", "source": true},
    "button_icon": {"label": "Closed button icon", "type": "icon"},
    "close_icon": {"label": "Open button icon", "type": "icon"},
    "button_pulse": {"type": "checkbox", "text": "Pulse the main button while the menu is closed"},
    "pulse_color": {"label": "Pulse color", "type": "color", "show": "button_pulse"},
    "pulse_opacity": {"label": "Pulse opacity", "type": "range", "attrs": {"min": 5, "max": 70, "step": 1}, "show": "button_pulse"},
    "pulse_scale": {"label": "Pulse size", "description": "Maximum pulse size as a percentage of the main button.", "type": "range", "attrs": {"min": 110, "max": 200, "step": 1}, "show": "button_pulse"},
    "pulse_duration": {"label": "Pulse duration", "description": "Animation cycle in milliseconds.", "type": "range", "attrs": {"min": 700, "max": 5000, "step": 100}, "show": "button_pulse"},
    "side": {"label": "Horizontal position", "type": "select", "options": {"Right": "right", "Center": "center", "Left": "left"}},
    "vertical_position": {"label": "Vertical position", "type": "select", "options": {"Bottom": "bottom", "Center": "middle", "Top": "top"}},
    "direction": {"label": "Open direction", "type": "select", "options": {"Up": "up", "Down": "down"}},
    "visibility_mode": {"label": "Responsive visibility", "type": "select", "options": {"All screens": "all", "Phones only (< 960px)": "mobile", "Phones and tablets (< 1200px)": "tablet"}},
    "show_labels": {"type": "checkbox", "text": "Show contact labels beside icons"},
    "show_tooltips": {"type": "checkbox", "text": "Show contact tooltips on hover and keyboard focus"},
    "tooltip_delay": {"label": "Tooltip delay", "description": "Delay before showing a tooltip in milliseconds.", "type": "range", "attrs": {"min": 0, "max": 1000, "step": 20}, "show": "show_tooltips"},
    "show_backdrop": {"type": "checkbox", "text": "Dim the page while open"},
    "backdrop_color": {"label": "Backdrop color", "type": "color", "show": "show_backdrop"},
    "backdrop_opacity": {"label": "Backdrop opacity", "type": "range", "attrs": {"min": 0, "max": 90, "step": 1}, "show": "show_backdrop"},
    "close_on_link": {"type": "checkbox", "text": "Close after a contact link is selected"},
    "open_initially": {"type": "checkbox", "text": "Open initially"},
    "horizontal_offset": {"label": "Horizontal offset", "description": "Offset from the selected side; ignored for centered placement.", "type": "range", "attrs": {"min": 0, "max": 240, "step": 1}},
    "bottom_offset": {"label": "Vertical offset", "description": "Offset from the selected top or bottom edge; ignored for centered placement.", "type": "range", "attrs": {"min": 0, "max": 500, "step": 1}},
    "z_index": {"label": "Layer", "type": "range", "attrs": {"min": 1, "max": 2000, "step": 1}},
    "button_size": {"label": "Main button size", "type": "range", "attrs": {"min": 40, "max": 120, "step": 1}},
    "item_size": {"label": "Contact button size", "type": "range", "attrs": {"min": 32, "max": 100, "step": 1}},
    "items_gap": {"label": "Contacts gap", "type": "range", "attrs": {"min": 0, "max": 50, "step": 1}},
    "button_background": {"label": "Main button background", "type": "color"},
    "button_color": {"label": "Main button icon", "type": "color"},
    "item_background": {"label": "Default contact background", "type": "color"},
    "item_color": {"label": "Default contact icon/text", "type": "color"},
    "position": "${builder.position}",
    "position_left": "${builder.position_left}",
    "position_right": "${builder.position_right}",
    "position_top": "${builder.position_top}",
    "position_bottom": "${builder.position_bottom}",
    "position_z_index": "${builder.position_z_index}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {"label": "CSS", "description": "Custom CSS is scoped to this help menu.", "type": "editor", "editor": "code", "mode": "css", "attrs": {"debounce": 500, "hints": [".el-element", ".rm-help-menu", ".rm-help-menu__trigger", ".rm-help-menu__panel", ".rm-help-menu__item", ".rm-help-menu__link", ".rm-help-menu__item-icon", ".rm-help-menu__label", ".rm-help-menu__backdrop"]}},
    "transform": "${builder.transform}"
  },
  "fieldset": {"default": {"type": "tabs", "fields": [
    {"title": "Content", "fields": ["content"]},
    {"title": "Settings", "fields": [
      {"label": "Main button", "type": "group", "fields": ["button_label", "button_icon", "close_icon", "button_size", "button_background", "button_color", "button_pulse", "pulse_color", "pulse_opacity", "pulse_scale", "pulse_duration"]},
      {"label": "Behaviour", "type": "group", "fields": ["direction", "visibility_mode", "show_labels", "show_tooltips", "tooltip_delay", "show_backdrop", "backdrop_color", "backdrop_opacity", "close_on_link", "open_initially"]},
      {"label": "Position and contacts", "type": "group", "fields": ["side", "vertical_position", "horizontal_offset", "bottom_offset", "z_index", "item_size", "items_gap", "item_background", "item_color"]},
      {"label": "General", "type": "group", "fields": ["position", "position_left", "position_right", "position_top", "position_bottom", "position_z_index", "visibility"]}
    ]},
    "${builder.advanced}"
  ]}}
}
