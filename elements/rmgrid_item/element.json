{
  "@import": "./element.php",
  "name": "rmgrid_item",
  "title": "rmgrid_item",
  "width": 500,
  "defaults": {
    "margin_top": "",
    "margin_bottom": ""
  },
  "placeholder": {
    "children": [
      {
        "type": "headline",
        "props": {
          "content": "Item",
          "title_element": "h3",
          "title_style": "h4"
        }
      },
      {
        "type": "text",
        "props": {
          "content": "Build this card with any YOOtheme or RadicalMart elements.",
          "margin_bottom": ""
        }
      }
    ]
  },
  "templates": {
    "render": "./templates/template.php",
    "content": "./templates/content.php"
  },
  "fields": {
    "content": {
      "label": "Card content",
      "description": "Build a custom card with any YOOtheme or RadicalMart elements and dynamic sources.",
      "type": "builder-fragment"
    },
    "tags": {
      "label": "Filter tags",
      "description": "Comma-separated tags used by the RM Grid filter. This field can be mapped to a dynamic source.",
      "type": "text",
      "source": true
    },
    "panel_style": {
      "label": "Style",
      "description": "Select one of the boxed card or tile styles or a blank panel.",
      "type": "select",
      "options": {
        "None": "",
        "Card Default": "card-default",
        "Card Primary": "card-primary",
        "Card Secondary": "card-secondary",
        "Card Hover": "card-hover",
        "Card Overlay": "card-overlay",
        "Tile Default": "tile-default",
        "Tile Muted": "tile-muted",
        "Tile Primary": "tile-primary",
        "Tile Secondary": "tile-secondary"
      }
    },
    "panel_padding": {
      "label": "Padding",
      "description": "Set the padding.",
      "type": "select",
      "options": {
        "None": "",
        "Small": "small",
        "Default": "default",
        "Large": "large"
      },
      "enable": "panel_style"
    },
    "item_maxwidth": {
      "type": "select",
      "label": "Max Width",
      "description": "Set the maximum width.",
      "options": {
        "None": "",
        "Small": "small",
        "Medium": "medium",
        "Large": "large",
        "X-Large": "xlarge",
        "2X-Large": "2xlarge"
      }
    },
    "html_element": "${builder.html_element}",
    "position": "${builder.position}",
    "position_left": "${builder.position_left}",
    "position_right": "${builder.position_right}",
    "position_top": "${builder.position_top}",
    "position_bottom": "${builder.position_bottom}",
    "position_z_index": "${builder.position_z_index}",
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "animation": "${builder.animation}",
    "_parallax_button": "${builder._parallax_button}",
    "visibility": "${builder.visibility}",
    "name": "${builder.nameItem}",
    "status": "${builder.statusItem}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS for this RM Grid item. Use .el-element for the card root and .rm-grid-item__content for its Builder content.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {
        "debounce": 500,
        "hints": [
          ".el-element",
          ".rm-grid-item__content"
        ]
      }
    }
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {
          "title": "Content",
          "fields": [
            "content",
            "tags"
          ]
        },
        {
          "title": "Settings",
          "fields": [
            {
              "label": "Sublayout",
              "type": "group",
              "fields": [
                "html_element"
              ]
            },
            {
              "label": "Panel",
              "type": "group",
              "divider": true,
              "fields": [
                "panel_style",
                "panel_padding",
                "item_maxwidth"
              ]
            },
            {
              "label": "General",
              "type": "group",
              "fields": [
                "position",
                "position_left",
                "position_right",
                "position_top",
                "position_bottom",
                "position_z_index",
                "margin_top",
                "margin_bottom",
                "animation",
                "_parallax_button",
                "visibility"
              ]
            }
          ]
        },
        "${builder.advanced}"
      ]
    }
  }
}
