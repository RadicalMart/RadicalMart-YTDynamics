{
  "@import": "./element.php",
  "name": "rmoneclick",
  "title": "RM One Click Order",
  "group": "RadicalMart — Product Actions",
  "icon": "${url:images/iconPicker.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "container": true,
  "width": 500,
  "placeholder": {
    "children": [
      {"type": "rmoneclick_item", "props": {"label": "Ф.И.О.", "field_name": "name", "field_type": "text", "autocomplete": "name", "required": true, "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Телефон", "field_name": "phone", "field_type": "tel", "placeholder": "+7 912 345-67-89", "autocomplete": "tel", "required": true, "width": "full", "error_text": "Укажите номер телефона"}},
      {"type": "rmoneclick_item", "props": {"label": "E-Mail", "field_name": "email", "field_type": "email", "autocomplete": "email", "required": true, "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Комментарий к заказу", "field_name": "comment", "field_type": "textarea", "rows": 4, "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Стоимость доставки", "field_name": "delivery", "field_type": "select", "options": "manager|Уточнить у менеджера\npickup|Самовывоз\ncourier|Доставка курьером", "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Адрес доставки", "field_name": "delivery_address", "field_type": "text", "placeholder": "Город, улица, дом, квартира", "autocomplete": "street-address", "required": true, "show_when_field": "delivery", "show_when_value": "courier", "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Я согласен(а) с условиями обработки персональных данных", "label_link_text": "обработки персональных данных", "field_name": "privacy", "field_type": "checkbox", "required": true, "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Я согласен(а) с условиями публичной оферты", "label_link_text": "публичной оферты", "field_name": "offer", "field_type": "checkbox", "required": true, "width": "full"}},
      {"type": "rmoneclick_item", "props": {"label": "Я согласен(а) с условиями передачи данных третьим лицам", "label_link_text": "передачи данных третьим лицам", "field_name": "third_party", "field_type": "checkbox", "required": true, "width": "full"}}
    ]
  },
  "defaults": {
    "radicalform_target": "oneclick",
    "subject": "Заказ в 1 клик: {product_name}",
    "rf_call": "2",
    "product_field_prefix": "product_",
    "send_product_id": true,
    "send_product_name": true,
    "send_product_code": true,
    "send_product_url": true,
    "send_product_price": true,
    "form_layout": "stacked",
    "form_control_size": "",
    "show_labels": true,
    "grid_gap": "small",
    "autocomplete": true,
    "display_mode": "modal",
    "trigger_display": "button",
    "button_label": "Заказать в 1 клик",
    "button_style": "primary",
    "button_size": "",
    "button_icon": "bolt",
    "button_icon_align": "left",
    "button_fullwidth": true,
    "button_align": "left",
    "modal_title": "Купить в 1 клик",
    "modal_size": "xlarge",
    "modal_layout": "split",
    "modal_center": true,
    "modal_bg_close": true,
    "modal_esc_close": true,
    "submit_label": "Отправить заказ",
    "submit_style": "primary",
    "submit_size": "large",
    "submit_icon": "check",
    "submit_icon_align": "left",
    "submit_fullwidth": true,
    "summary_show_image": true,
    "summary_show_price": true,
    "summary_show_bonus": false,
    "summary_show_stock": false,
    "summary_image_height": 460,
    "summary_image_height_mode": "fixed",
    "summary_image_fit": "contain",
    "summary_image_position": "center",
    "summary_image_background": "",
    "summary_mix_blend_mode": "normal",
    "summary_column_width": 40,
    "disable_out_of_stock": true
  },
  "templates": {
    "render": "./templates/template.php",
    "content": "./templates/content.php"
  },
  "fields": {
    "content": {
      "label": "Form fields",
      "description": "Add the visible and hidden inputs that RadicalForm should send.",
      "type": "content-items",
      "item": "rmoneclick_item"
    },
    "product_id": {
      "label": "Product ID",
      "description": "Optional outside RM Product or RM Product Card. Inside a product context the current product is used automatically.",
      "type": "number",
      "source": true
    },
    "radicalform_target": {
      "label": "RadicalForm Target ID",
      "description": "Written to the hidden rfTarget input. Use the same value in RadicalForm recipients or a custom PHP layout.",
      "type": "text",
      "source": true
    },
    "subject": {
      "label": "Email subject",
      "description": "Written to rfSubject. RadicalForm placeholders are supported, for example {product_name} or {phone}.",
      "type": "text",
      "source": true
    },
    "rf_call": {
      "label": "Success JavaScript handlers",
      "description": "Digits from RadicalForm data-rf-call, for example 12. Leave empty to use its default handler.",
      "type": "text"
    },
    "form_id": {
      "label": "Form ID",
      "description": "Optional HTML id. A unique id is generated when empty.",
      "type": "text",
      "source": true
    },
    "product_field_prefix": {
      "label": "Product field prefix",
      "description": "Prefix for automatic hidden fields: id, name, code, url and price.",
      "type": "text"
    },
    "send_product_id": {"type": "checkbox", "text": "Send the current product ID"},
    "send_product_name": {"type": "checkbox", "text": "Send the current product name"},
    "send_product_code": {"type": "checkbox", "text": "Send the current product code"},
    "send_product_url": {"type": "checkbox", "text": "Send the current product URL"},
    "send_product_price": {"type": "checkbox", "text": "Send the current final price"},
    "form_layout": {
      "label": "Label layout",
      "type": "select",
      "options": {"Stacked": "stacked", "Horizontal": "horizontal"}
    },
    "form_control_size": {
      "label": "Form control size",
      "description": "Uses the standard UIkit form size classes on inputs, selects and textareas.",
      "type": "select",
      "options": {"Default": "", "Small": "small", "Large": "large"}
    },
    "show_labels": {"type": "checkbox", "text": "Show field labels"},
    "grid_gap": {
      "label": "Fields gap",
      "type": "select",
      "options": {"None": "none", "Small": "small", "Default": "default", "Large": "large"}
    },
    "autocomplete": {"type": "checkbox", "text": "Enable browser autocomplete"},
    "display_mode": {
      "label": "Form display",
      "type": "select",
      "options": {"Modal window": "modal", "Inline": "inline"}
    },
    "trigger_display": {
      "label": "Trigger appearance",
      "description": "Icon only uses the standard UIkit icon-button and keeps the label for screen readers.",
      "type": "select",
      "options": {"Button": "button", "Icon only": "icon"},
      "show": "display_mode == 'modal'"
    },
    "button_label": {"label": "Button label", "type": "text", "source": true},
    "button_style": {
      "label": "Button style",
      "type": "select",
      "options": {"Default": "default", "Primary": "primary", "Secondary": "secondary", "Danger": "danger", "Text": "text", "Link": "link"},
      "show": "display_mode != 'modal' || trigger_display == 'button'"
    },
    "button_size": {
      "label": "Button size",
      "type": "select",
      "options": {"Default": "", "Small": "small", "Large": "large"},
      "show": "display_mode != 'modal' || trigger_display == 'button'"
    },
    "button_icon": {"label": "Button icon", "type": "icon"},
    "button_icon_align": {
      "label": "Icon position",
      "type": "select",
      "options": {"Left": "left", "Right": "right"},
      "show": "button_icon && (display_mode != 'modal' || trigger_display == 'button')"
    },
    "button_fullwidth": {"type": "checkbox", "text": "Full-width button", "show": "display_mode != 'modal' || trigger_display == 'button'"},
    "button_align": {
      "label": "Button alignment",
      "type": "select",
      "options": {"Left": "left", "Center": "center", "Right": "right"},
      "show": "!button_fullwidth"
    },
    "modal_title": {"label": "Modal title", "type": "text", "source": true, "show": "display_mode == 'modal'"},
    "modal_size": {
      "label": "Modal width",
      "type": "select",
      "options": {"Small": "small", "Default": "default", "Large": "large", "X-Large": "xlarge"},
      "show": "display_mode == 'modal'"
    },
    "modal_layout": {
      "label": "Modal layout",
      "type": "select",
      "options": {"Product summary + form": "split", "Form only": "form"},
      "show": "display_mode == 'modal'"
    },
    "modal_center": {"type": "checkbox", "text": "Vertically center modal", "show": "display_mode == 'modal'"},
    "modal_bg_close": {"type": "checkbox", "text": "Close by clicking the background", "show": "display_mode == 'modal'"},
    "modal_esc_close": {"type": "checkbox", "text": "Close with Escape", "show": "display_mode == 'modal'"},
    "submit_label": {"label": "Submit label", "type": "text", "source": true, "show": "display_mode == 'modal'"},
    "submit_style": {
      "label": "Submit style",
      "type": "select",
      "options": {"Default": "default", "Primary": "primary", "Secondary": "secondary", "Danger": "danger", "Text": "text", "Link": "link"},
      "show": "display_mode == 'modal'"
    },
    "submit_size": {
      "label": "Submit size",
      "type": "select",
      "options": {"Default": "", "Small": "small", "Large": "large"},
      "show": "display_mode == 'modal'"
    },
    "submit_icon": {"label": "Submit icon", "type": "icon", "show": "display_mode == 'modal'"},
    "submit_icon_align": {
      "label": "Submit icon position",
      "type": "select",
      "options": {"Left": "left", "Right": "right"},
      "show": "display_mode == 'modal' && submit_icon"
    },
    "submit_fullwidth": {"type": "checkbox", "text": "Full-width submit button", "show": "display_mode == 'modal'"},
    "summary_show_image": {"type": "checkbox", "text": "Show product image", "show": "display_mode == 'modal' && modal_layout == 'split'"},
    "summary_show_price": {"type": "checkbox", "text": "Show final price and unit", "show": "display_mode == 'modal' && modal_layout == 'split'"},
    "summary_show_bonus": {"type": "checkbox", "text": "Show product bonus", "show": "display_mode == 'modal' && modal_layout == 'split'"},
    "summary_show_stock": {"type": "checkbox", "text": "Show stock status", "show": "display_mode == 'modal' && modal_layout == 'split'"},
    "summary_column_width": {"label": "Summary column width", "type": "range", "attrs": {"min": 25, "max": 60, "step": 1}, "show": "display_mode == 'modal' && modal_layout == 'split'"},
    "summary_image_height_mode": {"label": "Image area height", "type": "select", "options": {"Use configured height": "fixed", "Fill available summary height": "fill"}, "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "summary_image_height": {"label": "Image height", "type": "range", "attrs": {"min": 160, "max": 720, "step": 10}, "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "summary_image_fit": {"label": "Image fit", "type": "select", "options": {"Contain": "contain", "Cover": "cover"}, "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "summary_image_position": {"label": "Image position", "type": "select", "options": {"Center": "center", "Top": "top", "Bottom": "bottom", "Left": "left", "Right": "right"}, "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "summary_image_background": {"label": "Image background", "type": "color", "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "summary_mix_blend_mode": {"label": "Image mix blend", "type": "select", "options": {"Normal": "normal", "Multiply": "multiply", "Screen": "screen", "Overlay": "overlay", "Darken": "darken", "Lighten": "lighten", "Difference": "difference", "Luminosity": "luminosity"}, "show": "display_mode == 'modal' && modal_layout == 'split' && summary_show_image"},
    "disable_out_of_stock": {"type": "checkbox", "text": "Disable ordering when the current product is out of stock"},
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "maxwidth": "${builder.maxwidth}",
    "maxwidth_breakpoint": "${builder.maxwidth_breakpoint}",
    "block_align": "${builder.block_align}",
    "block_align_breakpoint": "${builder.block_align_breakpoint}",
    "block_align_fallback": "${builder.block_align_fallback}",
    "animation": "${builder.animation}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS is scoped to this one-click order form.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {"debounce": 500, "hints": [".el-element", ".rm-oneclick-order", ".rm-oneclick-order__trigger-wrap", ".rm-oneclick-order__trigger", ".rm-oneclick-order__modal", ".rm-oneclick-order__dialog", ".rm-oneclick-order__layout", ".rm-oneclick-order__summary", ".rm-oneclick-order__summary-media", ".rm-oneclick-order__summary-image", ".rm-oneclick-order__summary-title", ".rm-oneclick-order__summary-price", ".rm-oneclick-order__summary-stock", ".rm-oneclick-order__content", ".rm-oneclick-order__form", ".rm-oneclick-order__fields", ".rm-oneclick-order__field", ".rm-oneclick-order__button"]}
    },
    "transform": "${builder.transform}"
  },
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {"title": "Content", "fields": ["content"]},
        {"title": "Settings", "fields": [
          {"label": "RadicalForm", "type": "group", "fields": ["radicalform_target", "subject", "rf_call", "form_id"]},
          {"label": "Product", "type": "group", "fields": ["product_id", "product_field_prefix", "send_product_id", "send_product_name", "send_product_code", "send_product_url", "send_product_price", "disable_out_of_stock"]},
          {"label": "Presentation", "type": "group", "fields": ["display_mode"]},
          {"label": "Trigger / Inline button", "type": "group", "fields": ["trigger_display", "button_label", "button_style", "button_size", "button_icon", "button_icon_align", "button_fullwidth", "button_align"]},
          {"label": "Modal", "type": "group", "fields": ["modal_title", "modal_size", "modal_layout", "modal_center", "modal_bg_close", "modal_esc_close"]},
          {"label": "Product summary", "type": "group", "fields": ["summary_show_image", "summary_show_price", "summary_show_bonus", "summary_show_stock", "summary_column_width", "summary_image_height_mode", "summary_image_height", "summary_image_fit", "summary_image_position", "summary_image_background", "summary_mix_blend_mode"]},
          {"label": "Submit button", "type": "group", "fields": ["submit_label", "submit_style", "submit_size", "submit_icon", "submit_icon_align", "submit_fullwidth"]},
          {"label": "Form", "type": "group", "fields": ["form_layout", "form_control_size", "show_labels", "grid_gap", "autocomplete"]},
          {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "maxwidth", "maxwidth_breakpoint", "block_align", "block_align_breakpoint", "block_align_fallback", "animation", "visibility"]}
        ]},
        "${builder.advanced}"
      ]
    }
  }
}
