{
  "@import": "./element.php", "name": "rmproductstock", "title": "RM Product Stock", "group": "RadicalMart — Product Data", "icon": "${url:images/iconPicker.svg}", "iconSmall": "${url:images/iconSmall.svg}", "element": true, "width": 500,
  "defaults": {"in_stock_label": "", "out_of_stock_label": "", "show_quantity": false, "show_progress": false, "progress_threshold": 10, "text_style": ""}, "templates": {"render": "./templates/template.php"},
  "fields": {"product_id": {"label": "Product ID", "type": "number", "source": true}, "in_stock_label": {"label": "In-stock label", "type": "text", "source": true}, "out_of_stock_label": {"label": "Out-of-stock label", "type": "text", "source": true}, "show_quantity": {"type": "checkbox", "text": "Show exact quantity when stock accounting is enabled"}, "show_progress": {"type": "checkbox", "text": "Show stock threshold progress"}, "progress_threshold": {"label": "Full progress at quantity", "description": "The progress reaches 100% at this stock quantity; it is not the product purchase limit.", "type": "number", "attrs": {"min": 1, "step": 1}, "show": "show_progress"}, "text_style": {"label": "Text style", "type": "select", "options": {"Default": "", "Meta": "meta", "Small": "small", "Lead": "lead"}},
  "margin_top": "${builder.margin_top}", "margin_bottom": "${builder.margin_bottom}", "visibility": "${builder.visibility}", "name": "${builder.name}", "status": "${builder.status}", "source": "${builder.source}", "id": "${builder.id}", "class": "${builder.cls}", "attributes": "${builder.attrs}", "css": {"label": "CSS", "type": "editor", "editor": "code", "mode": "css", "attrs": {"hints": [".el-element", ".rm-product-stock", ".rm-product-stock__status", ".rm-product-stock__amount", ".rm-product-stock__progress"]}}, "transform": "${builder.transform}"},
  "fieldset": {"default": {"type": "tabs", "fields": [{"title": "Settings", "fields": [{"label": "Stock", "type": "group", "fields": ["product_id", "in_stock_label", "out_of_stock_label", "show_quantity", "show_progress", "progress_threshold", "text_style"]}, {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "visibility"]}]}, "${builder.advanced}"]}}
}
