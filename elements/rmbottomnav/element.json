{
  "@import": "./element.php",
  "name": "rmbottomnav",
  "title": "RM Bottom Navigation",
  "group": "RadicalMart — Navigation",
  "icon": "${url:images/iconPicker.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "container": true,
  "width": 500,
  "placeholder": {
    "children": [
      {"type": "rmbottomnav_item", "props": {"title": "Главная", "icon": "home", "link": "/"}},
      {"type": "rmbottomnav_item", "props": {"title": "Каталог", "icon": "grid", "link": "/index.php"}},
      {"type": "rmbottomnav_item", "props": {"title": "Корзина", "icon": "cart", "link": "/index.php?option=com_radicalmart&view=cart"}},
      {"type": "rmbottomnav_item", "props": {"title": "Избранное", "icon": "heart", "link": "/index.php?option=com_radicalmart&view=favorites"}},
      {"type": "rmbottomnav_item", "props": {"title": "Сравнение", "icon": "copy", "link": "/index.php?option=com_radicalmart&view=compare"}},
      {"type": "rmbottomnav_item", "props": {"title": "Кабинет", "icon": "user", "link": "/index.php?option=com_users&view=profile"}}
    ]
  },
  "defaults": {
    "fixed": true,
    "reserve_space": false,
    "visibility_mode": "mobile",
    "layout_mode": "scroll",
    "hide_scrollbar": true,
    "show_labels": true,
    "auto_active": true,
    "bottom_offset": 0,
    "z_index": 1030,
    "max_width": 780,
    "item_min_width": 78,
    "columns": 5,
    "gap": 4,
    "padding_x": 8,
    "padding_y": 8,
    "icon_size": 28,
    "label_size": 13,
    "border_radius": 18,
    "background_color": "",
    "text_color": "",
    "active_color": ""
  },
  "templates": {"render": "./templates/template.php", "content": "./templates/content.php"},
  "fields": {
    "content": {"label": "Navigation items", "description": "Each item is a static link with its own icon, label, badge and active state.", "type": "content-items", "item": "rmbottomnav_item"},
    "fixed": {"type": "checkbox", "text": "Fix navigation to the bottom of the viewport"},
    "reserve_space": {"type": "checkbox", "text": "Reserve page space under the fixed navigation", "show": "fixed"},
    "visibility_mode": {"label": "Responsive visibility", "type": "select", "options": {"All screens": "all", "Phones only (< 960px)": "mobile", "Phones and tablets (< 1200px)": "tablet"}},
    "layout_mode": {"label": "Items layout", "description": "Scroll keeps every item at least the selected width. Proportional fits all items into one equal-width row. Fixed columns wrap items into the selected number of equal columns.", "type": "select", "options": {"Horizontal scroll": "scroll", "Proportional row": "stretch", "Fixed column grid": "grid"}},
    "show_labels": {"type": "checkbox", "text": "Show item labels"},
    "auto_active": {"type": "checkbox", "text": "Detect the active link from the current URL"},
    "hide_scrollbar": {"type": "checkbox", "text": "Hide horizontal scrollbar", "show": "layout_mode == 'scroll'"},
    "bottom_offset": {"label": "Bottom offset", "type": "range", "attrs": {"min": 0, "max": 240, "step": 1}},
    "z_index": {"label": "Layer", "type": "range", "attrs": {"min": 1, "max": 2000, "step": 1}},
    "max_width": {"label": "Maximum width", "description": "0 makes the navigation full width.", "type": "range", "attrs": {"min": 0, "max": 1600, "step": 10}},
    "item_min_width": {"label": "Scrollable item width", "description": "Minimum item width before the navigation starts scrolling.", "type": "range", "attrs": {"min": 48, "max": 220, "step": 1}, "show": "layout_mode == 'scroll'"},
    "columns": {"label": "Fixed columns", "description": "Items wrap into this number of equal-width columns.", "type": "range", "attrs": {"min": 1, "max": 12, "step": 1}, "show": "layout_mode == 'grid'"},
    "gap": {"label": "Items gap", "type": "range", "attrs": {"min": 0, "max": 40, "step": 1}},
    "padding_x": {"label": "Horizontal padding", "type": "range", "attrs": {"min": 0, "max": 60, "step": 1}},
    "padding_y": {"label": "Vertical padding", "type": "range", "attrs": {"min": 0, "max": 40, "step": 1}},
    "icon_size": {"label": "Icon size", "type": "range", "attrs": {"min": 14, "max": 64, "step": 1}},
    "label_size": {"label": "Label size", "type": "range", "attrs": {"min": 9, "max": 28, "step": 1}, "show": "show_labels"},
    "border_radius": {"label": "Top corner radius", "type": "range", "attrs": {"min": 0, "max": 60, "step": 1}},
    "background_color": {"label": "Background", "type": "color"},
    "text_color": {"label": "Text and icon", "type": "color"},
    "active_color": {"label": "Active color", "type": "color"},
    "position": "${builder.position}",
    "position_left": "${builder.position_left}",
    "position_right": "${builder.position_right}",
    "position_top": "${builder.position_top}",
    "position_bottom": "${builder.position_bottom}",
    "position_z_index": "${builder.position_z_index}",
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {"label": "CSS", "description": "Custom CSS is scoped to this navigation element.", "type": "editor", "editor": "code", "mode": "css", "attrs": {"debounce": 500, "hints": [".el-element", ".rm-bottom-navigation", ".rm-bottom-navigation__track", ".rm-bottom-navigation__item", ".rm-bottom-navigation__link", ".rm-bottom-navigation__icon", ".rm-bottom-navigation__label"]}},
    "transform": "${builder.transform}"
  },
  "fieldset": {"default": {"type": "tabs", "fields": [
    {"title": "Content", "fields": ["content"]},
    {"title": "Settings", "fields": [
      {"label": "Behaviour", "type": "group", "fields": ["fixed", "reserve_space", "visibility_mode", "show_labels", "auto_active", "bottom_offset", "z_index"]},
      {"label": "Layout and dimensions", "type": "group", "fields": ["layout_mode", "hide_scrollbar", "columns", "max_width", "item_min_width", "gap", "padding_x", "padding_y", "icon_size", "label_size", "border_radius"]},
      {"label": "Colors", "type": "group", "fields": ["background_color", "text_color", "active_color"]},
      {"label": "General", "type": "group", "fields": ["position", "position_left", "position_right", "position_top", "position_bottom", "position_z_index", "margin_top", "margin_bottom", "visibility"]}
    ]},
    "${builder.advanced}"
  ]}}
}
