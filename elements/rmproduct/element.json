{
  "@import": "./element.php",
  "name": "rmproduct",
  "title": "RM Product",
  "group": "RadicalMart — Product Data",
  "icon": "${url:images/iconPicker.svg}",
  "iconSmall": "${url:images/iconSmall.svg}",
  "element": true,
  "container": true,
  "width": 500,
  "placeholder": {
    "children": [
      {
        "type": "row",
        "props": {"column_gap": "large", "row_gap": "large"},
        "children": [
          {
            "type": "column",
            "props": {"width_medium": "1-2"},
            "children": [
              {"type": "rmproductgallery", "props": {"columns_s": 2, "columns_m": 2, "columns_l": 2, "columns_xl": 2, "column_gap": 4, "row_gap": 4, "initial_items": 4, "show_more": true, "image_ratio": "3/4", "image_fit": "cover", "image_loading": "eager", "mobile_layout": "scroll", "mobile_item_width": 78, "lightbox": true}}
            ]
          },
          {
            "type": "column",
            "props": {"width_medium": "1-2"},
            "children": [
              {"type": "rmproductfield", "props": {"field": "title", "title_element": "h1", "title_style": "h1", "link_product": false}},
              {"type": "rmproductfield", "props": {"field": "code", "text_style": "meta", "margin_top": "small"}},
              {"type": "rmproductfield", "props": {"field": "description", "text_style": "lead", "margin_top": "small"}},
              {"type": "rmproductprice", "props": {"show_unit": true, "unit_style": "long", "show_base_price": true, "show_discount": true, "discount_mode": "percent", "margin_top": "default"}},
              {"type": "rmproductfield", "props": {"field": "availability", "margin_top": "small"}},
              {"type": "rmvariantselector", "props": {"style": "buttons", "action": "ajax", "update_url": "replace", "margin_top": "default"}},
              {"type": "rmbuy", "props": {"show_count": true, "button_style": "primary", "margin_top": "default"}},
              {
                "type": "rmoneclick",
                "props": {
                  "radicalform_target": "oneclick",
                  "subject": "Заказ в 1 клик: {product_name}",
                  "display_mode": "modal",
                  "trigger_display": "button",
                  "button_label": "Купить в 1 клик",
                  "button_style": "default",
                  "button_size": "large",
                  "button_icon": "bolt",
                  "button_fullwidth": true,
                  "modal_title": "Купить в 1 клик",
                  "modal_size": "small",
                  "modal_center": true,
                  "submit_label": "Отправить заказ",
                  "submit_style": "primary",
                  "submit_size": "large",
                  "submit_icon": "check",
                  "submit_fullwidth": true,
                  "margin_top": "small"
                },
                "children": [
                  {"type": "rmoneclick_item", "props": {"label": "Имя", "field_name": "name", "field_type": "text", "placeholder": "Ваше имя", "autocomplete": "name", "width": "half"}},
                  {"type": "rmoneclick_item", "props": {"label": "Телефон", "field_name": "phone", "field_type": "tel", "placeholder": "+7 999 000-00-00", "autocomplete": "tel", "required": true, "width": "half", "error_text": "Укажите номер телефона"}},
                  {"type": "rmoneclick_item", "props": {"label": "Количество", "field_name": "quantity", "field_type": "number", "value_source": "product_quantity", "required": true, "width": "third"}},
                  {"type": "rmoneclick_item", "props": {"label": "Комментарий", "field_name": "comment", "field_type": "textarea", "placeholder": "Комментарий к заказу", "rows": 2, "width": "two-thirds"}}
                ]
              }
            ]
          }
        ]
      },
      {"type": "rmproductfield", "props": {"field": "full_description", "margin_top": "large"}},
      {"type": "rmproductspecifications", "props": {"margin_top": "large"}}
    ]
  },
  "templates": {"render": "./templates/template.php", "content": "./templates/content.php"},
  "fields": {
    "content": {
      "label": "Product layout",
      "description": "Build a complete product page. All nested RM product elements receive and update the same product state.",
      "type": "builder-fragment"
    },
    "product_id": {
      "label": "Product ID",
      "description": "Bind to RadicalMart Product > ID. The current product request is used as a fallback.",
      "type": "number",
      "source": true
    },
    "update_document_title": {"type": "checkbox", "text": "Update the browser title when a variant changes"},
    "update_document_metadata": {"type": "checkbox", "text": "Update canonical, description and social metadata when a variant changes"},
    "margin_top": "${builder.margin_top}",
    "margin_bottom": "${builder.margin_bottom}",
    "maxwidth": "${builder.maxwidth}",
    "maxwidth_breakpoint": "${builder.maxwidth_breakpoint}",
    "block_align": "${builder.block_align}",
    "block_align_breakpoint": "${builder.block_align_breakpoint}",
    "block_align_fallback": "${builder.block_align_fallback}",
    "text_align": "${builder.text_align}",
    "text_align_breakpoint": "${builder.text_align_breakpoint}",
    "text_align_fallback": "${builder.text_align_fallback}",
    "animation": "${builder.animation}",
    "visibility": "${builder.visibility}",
    "name": "${builder.name}",
    "status": "${builder.status}",
    "source": "${builder.source}",
    "id": "${builder.id}",
    "class": "${builder.cls}",
    "attributes": "${builder.attrs}",
    "css": {
      "label": "CSS",
      "description": "Custom CSS is scoped to the complete product context.",
      "type": "editor",
      "editor": "code",
      "mode": "css",
      "attrs": {"debounce": 500, "hints": [".el-element", ".rm-product", ".rm-product-field", ".rm-product-gallery", ".rmvariants", ".rm-product-specifications", ".rm-buy"]}
    },
    "transform": "${builder.transform}"
  },
  "defaults": {"update_document_title": true, "update_document_metadata": true},
  "fieldset": {
    "default": {
      "type": "tabs",
      "fields": [
        {"title": "Content", "fields": ["content"]},
        {"title": "Settings", "fields": [
          {"label": "Product", "type": "group", "fields": ["product_id", "update_document_title", "update_document_metadata"]},
          {"label": "General", "type": "group", "fields": ["margin_top", "margin_bottom", "maxwidth", "maxwidth_breakpoint", "block_align", "block_align_breakpoint", "block_align_fallback", "text_align", "text_align_breakpoint", "text_align_fallback", "animation", "visibility"]}
        ]},
        "${builder.advanced}"
      ]
    }
  }
}
